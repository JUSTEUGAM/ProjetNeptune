{% extends "base.html.twig" %}
{% block title %}
	{{ parent() }}
	- Inscription
{% endblock %}
{% block content %}
	<div class="container-fluid">
		<div class="row justify-content-center">
			<div class="col-12 col-md-6 align-items-center">
				<h1 class="text-center text-primary fw-bold m-2">Inscription</h1>
				<form action="" method="post">
					<input type="text" id="userName" name="userName" class="form-control" placeholder="Nom"  required>
                    <input type="text" id="userFirstName" name="userFirstName" class="form-control" placeholder="Prénom" required>
                    <input type="email" id="userEmail" name="userEmail" class="form-control" placeholder="Email" required>
                    <input type="text" id="userNum" name="userNum" class="form-control" placeholder="Numéro de téléphone" pattern="[0-9]{2}[0-9]{2}[0-9]{2}[0-9]{2}[0-9]{2}" required>
                    <input type="password" id="userPass" name="userPass" class="form-control" placeholder="Mot de passe" required>
					<div class="text-center">
						<input type="submit" value="S'inscrire" class="btn btn-primary m-2">
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}
